! ==========================================================
! Yekara Default Theme
! ==========================================================

! Surface
*background: #cdd7e3
*foreground: #000000

! Inactive Window
Fvwm*InactWinColorsetBG: #cdd7e3
Fvwm*InactWinColorsetFG: #000000
! Active Window
Fvwm*ActiveWinColorsetBG: #DDA0DD
Fvwm*ActiveWinColorsetFG: #000000

! Inactive Border
Fvwm*InactWinBorderColorsetBG: #cdd7e3

! Active Border
Fvwm*ActiveWinBorderColorsetBG: #DDA0DD

! Inactive Border
Fvwm*InactWinBorderColorsetFG: #000000

! Active Border
Fvwm*ActiveWinBorderColorsetFG: #000000

! Menu
Fvwm*MenuInactItemColorsetBG: #cdd7e3
Fvwm*MenuActItemColorsetBG: #DDA0DD

! Menu Title
Fvwm*MenuTitleColorsetBG: #DDA0DD
Fvwm*MenuTitleColorsetFG: #FFFFFF

! ----------------------------------------------------------
! Cursor
! ----------------------------------------------------------

Xcursor.theme: yekara-cursors
Xcursor.size: 24

! ----------------------------------------------------------
! YKFont
! ----------------------------------------------------------

Yekara*Font: helvetica, 12

*highlightThickness: 0
! Target the menu bar widget (usually named 'menubar' or of class XmRowColumn
*menubar.shadowThickness:  1
*menubar*XmCascadeButton.shadowThickness: 1

! 1. Tell the menu bar not to recalculate its own height
*menubar.resizeHeight: False

! 2. Force the exact pixel height
*menubar.height: 21

! 3. Force the internal buttons not to try and stretch the container
*menubar*XmCascadeButton.resizeHeight: False
