#!/usr/bin/env python3

import os
import sys
import shutil
import subprocess
from pathlib import Path

YEKARA_VERSION = "R1 alpha"


def log(msg):
    print(f"[Yekara] {msg}")


# --------------------------------------------------
# Basic sanity check
# --------------------------------------------------

HOME = os.environ.get("HOME")

if not HOME:
    print("Error: HOME not set.", file=sys.stderr)
    sys.exit(2)

# --------------------------------------------------
# Version arguments
# --------------------------------------------------

if len(sys.argv) > 1:
    if sys.argv[1] == "-V":
        print(f"Yekara Desktop Interface System Version {YEKARA_VERSION}")
        sys.exit(0)

    if sys.argv[1] == "-v":
        print(YEKARA_VERSION)
        sys.exit(0)

FVWM_OPTS = sys.argv[1:]

# --------------------------------------------------
# DPI Detection
# --------------------------------------------------

try:
    xdpyinfo = subprocess.run(
        ["xdpyinfo"],
        capture_output=True,
        text=True,
        check=True
    )

    DPI = "72"

    for line in xdpyinfo.stdout.splitlines():
        if "resolution:" in line:
            for token in line.split():
                if "x" in token:
                    DPI = token.split("x")[-1]
                    break

    log(f"DPI detected: {DPI}")

except Exception as e:
    DPI = "72"
    log(f"DPI detection failed, using {DPI}: {e}")

os.environ["DPI"] = DPI

# --------------------------------------------------
# Core Environment
# --------------------------------------------------

os.environ["YEKARA_VERSION"] = YEKARA_VERSION
os.environ["YEKARA_OS"] = os.uname().sysname

os.environ["YEKARA_ROOT"] = "/usr/share"
os.environ["YEKARA_DATADIR"] = "/usr/share/yekara"
os.environ["YEKARA_LIBDIR"] = "/usr/local/lib/yekara"
os.environ["YEKARA_TOOLSDIR"] = "/usr/local/libexec/yekara"

os.environ["FVWM_DATADIR"] = "/usr/share/yekara"
os.environ["FVWM_USERDIR"] = f"{HOME}/.yekara"

os.environ["QT_QPA_PLATFORMTHEME"] = "qt6ct"

FVWM_USERDIR = Path(os.environ["FVWM_USERDIR"])
FVWM_DATADIR = Path(os.environ["FVWM_DATADIR"])

(FVWM_USERDIR / "tmp").mkdir(
    parents=True,
    exist_ok=True
)

# --------------------------------------------------
# Ensure /usr/local/bin exists in PATH
# --------------------------------------------------

path = os.environ.get("PATH", "")

if "/usr/local/bin" not in path.split(":"):
    os.environ["PATH"] = path + ":/usr/local/bin"

# --------------------------------------------------
# Locate FVWM
# --------------------------------------------------

FVWM_BIN = os.environ.get("FVWM_BIN")

if not FVWM_BIN:
    for candidate in ("fvwm3", "fvwm2", "fvwm"):
        found = shutil.which(candidate)

        if found:
            FVWM_BIN = found
            break

if not FVWM_BIN:
    print(
        "Error: could not find fvwm3, fvwm2 or fvwm",
        file=sys.stderr
    )
    sys.exit(3)

log(f"Found FVWM: {FVWM_BIN}")

# --------------------------------------------------
# Xdefaults
# --------------------------------------------------

xdefaults = FVWM_USERDIR / "Xdefaults"

if xdefaults.is_file():

    xrdb = shutil.which("xrdb")
    cpp = shutil.which("cpp")

    if xrdb and cpp:

        log("Loading Xdefaults")

        subprocess.run(
            [xrdb, "-remove"],
            check=False
        )

        with open(xdefaults, "r") as fp:
            subprocess.run(
                [xrdb, "-cpp", cpp],
                stdin=fp,
                check=False
            )

    else:
        log("xrdb or cpp not found")

else:
    log("No Xdefaults file")

# --------------------------------------------------
# app-defaults
# --------------------------------------------------

app_defaults = FVWM_USERDIR / "app-defaults"

if app_defaults.is_dir():
    os.environ["XAPPLRESDIR"] = str(app_defaults)
    log("Using app-defaults directory")

# --------------------------------------------------
# Optional Xset.conf
# --------------------------------------------------

xset_conf = FVWM_USERDIR / "Xset.conf"

if xset_conf.exists():
    log(
        "Xset.conf exists "
        "(shell execution not implemented yet)"
    )

# --------------------------------------------------
# Config Selection
# --------------------------------------------------

user_main = FVWM_USERDIR / "main.fvwm"
system_main = FVWM_DATADIR / "main.fvwm"

if user_main.is_file():
    config = user_main
else:
    config = system_main

if not config.is_file():
    print(
        f"Error: config file not found: {config}",
        file=sys.stderr
    )
    sys.exit(4)

log(f"Using config: {config}")

# --------------------------------------------------
# Launch FVWM
# --------------------------------------------------

cmd = [
    FVWM_BIN,
    "-f",
    str(config)
]

cmd.extend(FVWM_OPTS)

log("Launching FVWM...")
log("Command: " + " ".join(cmd))

os.execv(FVWM_BIN, cmd)